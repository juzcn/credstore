# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtualenvs
.venv/
venv/

# Credential files — the default path is ~/.credstore/, but CREDSTORE_FILE
# (or running from a checkout) can drop one in the working directory.  It
# is an encrypted backup and must never be committed.
credentials.crypt
credentials.crypt.bak

